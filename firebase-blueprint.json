{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator account profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] },
        "fullName": { "type": "string" },
        "createdAt": { "type": "string" },
        "recoveryEmail": { "type": "string" }
      },
      "required": ["uid", "username", "email", "role"]
    },
    "Department": {
      "title": "Department",
      "description": "College academic department or parent group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "coordinator": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Curriculum course subject assigned to parent department or group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "departmentId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "course": { "type": "string" },
        "semester": { "type": "string" },
        "section": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "departmentId", "code", "name"]
    },
    "PracticalForm": {
      "title": "PracticalForm",
      "description": "Independent practical examination evaluation form like Google Forms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "departmentId": { "type": "string" },
        "course": { "type": "string" },
        "semester": { "type": "string" },
        "section": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectCode": { "type": "string" },
        "subjectName": { "type": "string" },
        "examName": { "type": "string" },
        "examYear": { "type": "string" },
        "maxMarks": { "type": "number" },
        "minPassingMarks": { "type": "number" },
        "instructions": { "type": "string" },
        "examDate": { "type": "string" },
        "allowDecimals": { "type": "boolean" },
        "token": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published", "closed"] },
        "isActive": { "type": "boolean" },
        "isStudentListLocked": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "departmentId", "subjectId", "maxMarks", "token", "status"]
    },
    "Student": {
      "title": "Student",
      "description": "Master student candidate identity with permanent studentId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rollNumber": { "type": "string" },
        "studentName": { "type": "string" },
        "fatherName": { "type": "string" },
        "departmentId": { "type": "string" },
        "course": { "type": "string" },
        "semester": { "type": "string" },
        "section": { "type": "string" },
        "academicSession": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "rollNumber", "studentName"]
    },
    "FormEnrollment": {
      "title": "FormEnrollment",
      "description": "Student enrolled in a practical form with verified snapshot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "practicalFormId": { "type": "string" },
        "studentId": { "type": "string" },
        "rollNumber": { "type": "string" },
        "studentName": { "type": "string" },
        "fatherName": { "type": "string" },
        "departmentId": { "type": "string" },
        "course": { "type": "string" },
        "semester": { "type": "string" },
        "section": { "type": "string" },
        "academicSession": { "type": "string" },
        "status": { "type": "string", "enum": ["enrolled", "verified", "removed"] },
        "enrolledAt": { "type": "string" }
      },
      "required": ["id", "practicalFormId", "studentId", "rollNumber", "studentName"]
    },
    "MarksRecord": {
      "title": "MarksRecord",
      "description": "Evaluation marks record for a student in a specific practical form",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "practicalFormId": { "type": "string" },
        "studentId": { "type": "string" },
        "rollNumber": { "type": "string" },
        "studentName": { "type": "string" },
        "marksObtained": { "type": "number" },
        "isPresent": { "type": "boolean" },
        "remarks": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "practicalFormId", "studentId", "rollNumber"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of all administrative and marks operations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "details", "timestamp"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "College settings and bootstrap state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "isBootstrapped": { "type": "boolean" },
        "collegeName": { "type": "string" },
        "adminUsername": { "type": "string" },
        "adminEmail": { "type": "string" },
        "recoveryEmail": { "type": "string" },
        "bootstrappedAt": { "type": "string" }
      },
      "required": ["isBootstrapped"]
    },
    "AcademicSession": {
      "title": "AcademicSession",
      "description": "Four-year degree academic session (e.g. 2023-27, 2024-28)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionName": { "type": "string" },
        "startYear": { "type": "number" },
        "endYear": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sessionName"]
    },
    "AcademicPaper": {
      "title": "AcademicPaper",
      "description": "Manually added examination paper under a session, semester, and subject type",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "session": { "type": "string" },
        "semester": { "type": "string" },
        "subjectType": { "type": "string", "enum": ["MJC", "MIC", "MDC"] },
        "paperName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "session", "semester", "subjectType", "paperName"]
    },
    "PracticalSubject": {
      "title": "PracticalSubject",
      "description": "Master practical subject (BOTANY, CHEMISTRY, PHYSICS, ZOOLOGY, GEOGRAPHY, PSYCHOLOGY, HOME SCIENCE)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "PaperStudent": {
      "title": "PaperStudent",
      "description": "Student candidate uploaded and enrolled in a specific paper and practical subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paperId": { "type": "string" },
        "session": { "type": "string" },
        "semester": { "type": "string" },
        "subjectType": { "type": "string", "enum": ["MJC", "MIC", "MDC"] },
        "paperName": { "type": "string" },
        "rollNumber": { "type": "string" },
        "studentName": { "type": "string" },
        "subject": { "type": "string" },
        "fatherName": { "type": "string" },
        "section": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "paperId", "rollNumber", "studentName", "subject"]
    },
    "ExaminerAssignment": {
      "title": "ExaminerAssignment",
      "description": "Examiner and incharge assignment with marks configuration and unique access token",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "session": { "type": "string" },
        "semester": { "type": "string" },
        "subjectType": { "type": "string", "enum": ["MJC", "MIC", "MDC"] },
        "paperId": { "type": "string" },
        "paperName": { "type": "string" },
        "subjectName": { "type": "string" },
        "inchargeName": { "type": "string" },
        "examinerName": { "type": "string" },
        "maxMarks": { "type": "number" },
        "minMarks": { "type": "number" },
        "allowDecimals": { "type": "boolean" },
        "token": { "type": "string" },
        "status": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "paperId", "token", "maxMarks", "minMarks", "status"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin users"
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Academic departments"
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Subjects directory"
    },
    "/practicalForms/{formId}": {
      "schema": { "$ref": "#/entities/PracticalForm" },
      "description": "Practical examination forms"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Master student candidate directory"
    },
    "/formEnrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/FormEnrollment" },
      "description": "Form-wise verified student enrollment snapshots"
    },
    "/marks/{markId}": {
      "schema": { "$ref": "#/entities/MarksRecord" },
      "description": "Examination marks evaluations"
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Audit activity logs"
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "College and bootstrap configurations"
    },
    "/academicSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/AcademicSession" },
      "description": "Academic sessions"
    },
    "/academicPapers/{paperId}": {
      "schema": { "$ref": "#/entities/AcademicPaper" },
      "description": "Academic examination papers"
    },
    "/practicalSubjects/{subjectId}": {
      "schema": { "$ref": "#/entities/PracticalSubject" },
      "description": "Practical subject master"
    },
    "/paperStudents/{studentId}": {
      "schema": { "$ref": "#/entities/PaperStudent" },
      "description": "Paper student candidates"
    },
    "/examinerAssignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/ExaminerAssignment" },
      "description": "Examiner evaluation assignments"
    }
  }
}
